---
/* An error-rate cell: bold value, plus a note mark when the result carries a
   caveat. The 95% CI stays in the data and the tooltips; it is not shown in
   the table to keep the column narrow. */
import type { Cell } from '../lib/types';
import { fmtErr } from '../lib/format';
import { jsonForScript } from '../lib/json';

interface Props { cell: Cell | null | undefined }
const { cell } = Astro.props;
---
{!cell
  ? <span class="dim">—</span>
  : <span><span class="err-main">{fmtErr(cell.err)}</span>{cell.note && <span class="note-mark" tabindex="0" data-tip={jsonForScript({ t: 'note', r: [[cell.note, '']] })}> *</span>}</span>}
